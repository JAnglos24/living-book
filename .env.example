# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# GitHub PAT used for git operations against JAnglos24/living-book (repo push/pull).
# Only needed if you're not relying on Git Credential Manager for auth.
GITHUB_TOKEN=

# Cloudflare Pages/Workers deploy (wrangler). Only needed for non-interactive/CI deploys —
# interactive `wrangler deploy` uses your browser-login session instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
