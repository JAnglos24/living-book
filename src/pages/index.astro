---
import SeoHead from '../components/SeoHead.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>José Ángel Sosa López (J. Angel Sosa) — Senior Portfolio Manager & Product Management Director</title>
<meta name="description" content="IT Portfolio Leadership — Product & Project Perspective. Ideas, frameworks and field experience at the intersection of physical products, digital platforms, projects and enterprise portfolios.">
<link rel="preload" as="image" href="/assets/jas-warm.webp" type="image/webp">
<link rel="preload" href="/fonts/Archivo-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<style>
:root{
  --black:#070809; --graphite:#111418; --paper:#F7F8FA; --gray:#C9D0D8; --line:#AEB8C4; --ink2:#5C6673;
  --cobalt:#0057D9; --cobalt-deep:#003F9E; --cobalt-light:#2E7CFF;
  --grot:"Archivo",Helvetica,Arial,sans-serif; --serif:"Source Serif 4",Georgia,serif;
  --m:clamp(32px,4vw,72px);
  --ease:cubic-bezier(.65,0,.35,1);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--graphite);font-family:var(--grot);font-size:clamp(15px,.9rem+.25vw,18px);line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:2px solid var(--cobalt-light);outline-offset:4px}
h1,h2,h3,p{margin:0}
.eyebrow{font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;font-weight:500;display:flex;align-items:center;gap:1rem}
.eyebrow::after{content:"";width:2.5rem;height:1px;background:currentColor;opacity:.6}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
@media (max-width:800px){:root{--m:22px}}

/* ============ SCENE 00 — HERO ============ */
.hero{position:relative;height:190svh;background:var(--black)}
.hero .stage{position:sticky;top:0;height:100svh;overflow:hidden;background:var(--black)}
.hero .stage::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(7,8,9,.42),rgba(7,8,9,0) 30%,rgba(7,8,9,0) 66%,rgba(7,8,9,.6))}
/* photo: taller than the stage so translating it actually pans across new pixels */
.hero .photo{position:absolute;left:0;right:0;top:-2svh;height:118svh;z-index:0;overflow:hidden;will-change:transform}
.hero .photo img{width:100%;height:100%;object-fit:cover;object-position:68% 24%;transform:scale(1.10);transform-origin:center center}
/* typographic knockout mask — black plane, transparent letters revealing the moving wallpaper */
.hero .maskwrap{position:absolute;inset:0;z-index:2;pointer-events:none;will-change:transform,opacity;opacity:0;transform:scale(.985);animation:reveal 1.15s var(--ease) .2s forwards}
.hero .name-mask{width:100%;height:100%;display:block}
.hero .name-mask.mobile{display:none}
.hero .name-mask.desktop{overflow:visible}
.hero .name-mask text{font-family:var(--grot);font-weight:900;font-variation-settings:"wdth" 118;letter-spacing:-.025em}
@keyframes reveal{to{opacity:1;transform:scale(1)}}
.hero .ui{position:absolute;inset:0;z-index:3;pointer-events:none;color:var(--paper)}
.hero .ui>*{pointer-events:auto}
.hero .mark{position:absolute;top:1.4rem;left:var(--m);font-weight:600;letter-spacing:.06em;font-size:1.05rem;text-decoration:none;opacity:0;animation:fade .8s var(--ease) 1.5s forwards}
.hero .topright{position:absolute;top:1.5rem;right:var(--m);display:flex;align-items:center;gap:1.6rem;opacity:0;animation:fade .8s var(--ease) 1.5s forwards}
.hero .topright .lang{display:flex;align-items:center;gap:6px;font-size:max(11px,.68rem);letter-spacing:.16em}
.hero .topright .lang a{text-decoration:none;color:rgba(247,248,250,.6)}
.hero .topright .lang a[aria-current]{color:var(--paper);font-weight:700}
.hero .menu{display:flex;align-items:center;gap:.9rem;font-size:max(11px,.68rem);letter-spacing:.24em;text-decoration:none}
.hero .menu i{width:36px;height:10px;border-top:1px solid;border-bottom:1px solid}
.hero .role{position:absolute;left:var(--m);bottom:2.2rem;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;font-weight:500;opacity:0;animation:fade .9s var(--ease) 1.2s forwards}
.hero .quote{position:absolute;right:var(--m);bottom:6.5rem;font-family:var(--serif);font-style:italic;font-size:clamp(1rem,1.4vw,1.4rem);line-height:1.35;max-width:16ch;text-align:right;opacity:0;animation:fade .9s var(--ease) 1.7s forwards}
.hero .quote::after{content:"";display:block;width:2.4rem;height:1px;background:var(--paper);margin-top:1rem;opacity:.7;margin-left:auto}
.hero .cue{position:absolute;left:50%;bottom:1.6rem;width:1px;height:2.6rem;background:linear-gradient(var(--paper),transparent);opacity:0;animation:fade .8s var(--ease) 1.9s forwards}
@keyframes fade{to{opacity:1}}
@media (max-width:800px){
  .hero .photo{top:-10svh;height:126svh}
  .hero .photo img{object-position:64% 20%}
  .hero .quote{display:none}
  .hero .role{bottom:3rem;max-width:22ch;line-height:1.6}
  .hero .name-mask.desktop{display:none}
  .hero .name-mask.mobile{display:block}
}
/* ============ SCENE 01 — LIVING BOOK ============ */
.book{position:relative;z-index:2;background:var(--paper);display:grid;grid-template-columns:55% 45%;min-height:100svh;align-items:stretch;box-shadow:0 -40px 90px rgba(0,0,0,.28)}
.book .text{padding:clamp(4.2rem,8vh,7rem) clamp(2rem,3vw,4rem) clamp(3rem,6vh,4.5rem) var(--m);display:flex;flex-direction:column;justify-content:center}
.book .eyebrow{color:var(--graphite)}
.book h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(58px,6.9vw,128px);line-height:.86;letter-spacing:-.058em;margin:1.8rem 0 1.4rem;max-width:8.6ch}
.book .sub{font-size:clamp(19px,1.55vw,28px);line-height:1.25;color:var(--ink2);font-weight:400;letter-spacing:-.015em;max-width:31ch;margin-bottom:1.25rem}
.book .sum{font-size:clamp(15px,.55vw + .8rem,18px);line-height:1.5;max-width:42ch;margin-bottom:2rem;color:#2B323A}
.book .cta-row{display:flex;flex-wrap:wrap;gap:1rem}
.book .cta{display:inline-flex;align-items:center;gap:1.2rem;background:var(--cobalt);color:#fff;text-decoration:none;font-weight:500;padding:1.05rem 1.45rem;font-size:.92rem;transition:background .35s var(--ease),color .35s var(--ease),border-color .35s var(--ease);border:1.5px solid var(--cobalt)}
.book .cta.ghost{background:transparent;color:var(--graphite);border-color:var(--line)}
.book .cta.ghost:hover,.book .cta.ghost:focus-visible{border-color:var(--graphite);background:transparent;color:var(--graphite)}
.book .cta svg{width:22px;height:12px;transition:transform .35s var(--ease)}
.book .cta:hover,.book .cta:focus-visible{background:var(--cobalt-deep)}
.book .cta:hover svg,.book .cta:focus-visible svg{transform:translateX(10px)}
.book .object{position:relative;align-self:stretch;min-height:100svh;display:grid;place-items:center;overflow:hidden;background:linear-gradient(90deg,#F7F8FA 0%,#F2F4F7 100%)}
.book .object .layer{position:absolute;left:50%;top:50%;will-change:transform}
.book .object .blueprint{width:92%;max-width:720px;opacity:.70;z-index:1;mix-blend-mode:multiply}
.book .object .chair{width:68%;max-width:560px;z-index:2;filter:drop-shadow(0 28px 38px rgba(17,20,24,.12))}
.book .object img{width:100%;height:auto;display:block}
.book .note{position:absolute;z-index:3;font-size:max(11px,.6rem);letter-spacing:.2em;text-transform:uppercase;line-height:1.9;color:var(--ink2)}
.book .note::after{content:"";display:block;width:1.8rem;height:1px;background:var(--line);margin-top:.5rem}
.book .n1{top:clamp(2rem,7vh,4.5rem);left:8%}.book .n2{top:clamp(2rem,7vh,4.5rem);right:var(--m);text-align:right}.book .n3{bottom:clamp(2rem,7vh,4.5rem);right:var(--m);text-align:right}

/* metrics live inside the book teaser, as in the approved visual */
.book-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(1rem,1.8vw,2.2rem);margin-top:clamp(3.1rem,6vh,4.8rem);padding-top:clamp(1.7rem,3vh,2.4rem);border-top:1px solid var(--line);max-width:1320px}
.book-metrics .metric{position:relative;padding-right:1.1rem;min-width:0;display:flex;flex-direction:column;justify-content:flex-start}
.book-metrics .metric:not(:last-child)::after{content:"";position:absolute;right:0;top:8%;height:78%;width:1px;background:var(--line)}
.book-metrics b{display:block;font-family:var(--grot);font-style:normal;font-weight:800;font-variation-settings:"wdth" 110;font-size:clamp(55px,5vw,85px);line-height:.78;letter-spacing:-.07em;color:var(--graphite);margin-bottom:.32rem}
.book-metrics .label{display:block;font-size:clamp(11px,.22vw + 9px,15px);letter-spacing:.16em;text-transform:uppercase;color:var(--ink2);line-height:1.08;font-weight:500;max-width:14ch}
.book-metrics .metric:first-child b{font-size:clamp(59px,5.5vw,89px)}
.book-metrics .clip{display:block;font-size:inherit;line-height:inherit;letter-spacing:inherit;font-weight:inherit;color:inherit;transform:translateY(115%);transition:transform .85s var(--ease)}
.book-metrics .metric.infinity b{font-size:clamp(64px,5.75vw,94px);line-height:.72}
.book-metrics.in .clip{transform:none}
.reveal{opacity:0;transform:translateY(34px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.in{opacity:1;transform:none}
@media (max-width:1100px){
  .book h2{font-size:clamp(54px,7.8vw,92px)}
  .book-metrics b{font-size:clamp(46px,4.5vw,69px)}
  .book-metrics .metric.infinity b{font-size:clamp(52px,5vw,75px)}
}
@media (max-width:900px){
  .book{grid-template-columns:1fr;min-height:0}
  .book .text{padding:clamp(3.5rem,8vh,5rem) var(--m) 2.5rem}
  .book .object{min-height:72svh}
  .book .note{display:none}
  .book .object .blueprint{width:96%}.book .object .chair{width:72%}
  .book-metrics{margin-top:3rem}
}
@media (max-width:620px){
  .book h2{font-size:clamp(50px,15vw,74px);max-width:9ch}
  .book-metrics{grid-template-columns:repeat(2,1fr);gap:1rem 1.1rem}
  .book-metrics .metric{padding-right:.7rem}
  .book-metrics b{font-size:clamp(36px,9.5vw,54px)}
  .book-metrics .metric.infinity b{font-size:clamp(41px,10.5vw,59px)}
  .book-metrics .label{font-size:max(11px,.62rem);letter-spacing:.11em;line-height:1.35}
}

/* ============ SCENE 02 — CINEMATIC STRIP ============ */
.strip{position:relative;z-index:2;height:135svh;background:var(--black)}
.strip .scene{position:sticky;top:calc((100svh - 86svh)/2);height:86svh;overflow:hidden}
.strip .bg{position:absolute;inset:-6%;z-index:0;will-change:transform}
.strip .bg img{width:100%;height:100%;object-fit:cover;object-position:center}
.strip .fig{position:absolute;left:60%;bottom:11%;height:54%;z-index:2;will-change:transform}
.strip .fig img{height:100%;width:auto;display:block}
.strip .shadow{position:absolute;left:60%;bottom:11%;z-index:1;width:clamp(120px,12vw,220px);height:12px;background:radial-gradient(50% 50% at 50% 50%,rgba(0,0,0,.85),transparent 70%);transform-origin:50% 0;translate:-50% 0;will-change:transform,opacity}
.strip .say{position:absolute;z-index:3;left:var(--m);top:50%;transform:translateY(-50%);color:var(--paper);font-family:var(--serif);font-style:italic;font-size:clamp(1.35rem,1rem+1.7vw,2.6rem);line-height:1.28;max-width:14ch;letter-spacing:-.01em;will-change:transform}
.strip .say small{display:block;font-family:var(--grot);font-style:normal;font-size:max(11px,.62rem);letter-spacing:.28em;text-transform:uppercase;margin-top:1.6rem}
.strip .say small::after{content:"";display:inline-block;width:2.4rem;height:1px;background:var(--paper);vertical-align:middle;margin-left:1rem}
@media (max-width:800px){
  .strip{height:120svh}.strip .scene{height:80svh;top:10svh}
  .strip .fig{left:74%;bottom:8%;height:44%}.strip .shadow{left:74%;bottom:8%}
  .strip .say{max-width:11ch;font-size:clamp(1.2rem,5vw,1.7rem);top:32%}
}
/* ============ SCENE 04 — NAV ============ */
.nav{position:relative;z-index:2;background:var(--paper);display:grid;grid-template-columns:repeat(5,1fr);border-bottom:1px solid var(--line)}
.nav a{display:block;padding:clamp(2rem,4vh,3.2rem) var(--m) clamp(2rem,4vh,3.2rem) 1.6rem;text-decoration:none;border-right:1px solid var(--line);position:relative;overflow:hidden;transition:background .35s var(--ease)}
.nav a:first-child{padding-left:var(--m)}
.nav a:last-child{border-right:0}
.nav b{display:block;font-size:.8rem;letter-spacing:.24em;text-transform:uppercase;font-weight:600;margin-bottom:.4rem;transition:transform .35s var(--ease)}
.nav span{display:block;font-size:.9rem;color:var(--ink2);line-height:1.4;transition:transform .35s var(--ease)}
.nav i{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--cobalt);transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)}
.nav em{position:absolute;right:1.4rem;top:50%;font-style:normal;color:var(--cobalt);transform:translate(-8px,-50%);opacity:0;transition:transform .35s var(--ease),opacity .35s}
.nav a:hover,.nav a:focus-visible{background:#EEF1F5}
.nav a:hover i,.nav a:focus-visible i{transform:scaleX(1)}
.nav a:hover b,.nav a:focus-visible b{transform:translateX(3px)}
.nav a:hover em,.nav a:focus-visible em{transform:translate(0,-50%);opacity:1}
@media (max-width:900px){.nav{grid-template-columns:1fr}.nav a{border-right:0;border-bottom:1px solid var(--line);padding:1.5rem var(--m)}.nav a:last-child{border-bottom:0}}

footer{position:relative;z-index:2;background:var(--paper);padding:1.6rem var(--m) 2.4rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.8rem 2rem;font-size:max(11px,.62rem);letter-spacing:.22em;text-transform:uppercase;color:var(--ink2)}
footer a{text-decoration:none}
footer nav{display:flex;gap:2rem}

/* ============ SCENE 02 — LO QUE HAGO (propuesta) ============ */
.does{position:relative;z-index:2;background:var(--paper);display:grid;grid-template-columns:55% 45%;border-top:1px solid var(--line)}
.does .steps{padding:0 clamp(2rem,3vw,4rem) 0 var(--m)}
.does .intro{min-height:78svh;display:flex;flex-direction:column;justify-content:center;padding:clamp(4rem,8vh,7rem) 0 2rem}
.does .intro .eyebrow{color:var(--graphite)}
.does h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(50px,6.2vw,116px);line-height:.88;letter-spacing:-.055em;margin:1.8rem 0 1.4rem;max-width:9ch}
.does .intro p.sub{font-size:clamp(19px,1.55vw,28px);line-height:1.25;color:var(--ink2);letter-spacing:-.015em;max-width:30ch}
.does .step{min-height:84svh;display:flex;flex-direction:column;justify-content:center;border-top:1px solid var(--line);padding:clamp(2.4rem,6vh,4rem) 0;opacity:.34;transition:opacity .6s var(--ease)}
.does .step.on{opacity:1}
.does .step .kw{display:none}
.does .step h3{font-weight:700;font-variation-settings:"wdth" 100;font-size:clamp(34px,3.6vw,64px);line-height:.96;letter-spacing:-.04em;margin-bottom:1.2rem;max-width:12ch}
.does .step p{font-family:var(--serif);font-size:clamp(18px,1.2vw,23px);line-height:1.55;color:#2B323A;max-width:38ch;margin-bottom:1.6rem}
.does .step a.go{display:inline-flex;align-items:center;gap:1rem;font-size:.92rem;font-weight:500;text-decoration:none;color:var(--cobalt);border-bottom:1.5px solid var(--cobalt);padding-bottom:.35rem;min-height:44px;align-self:flex-start;transition:color .35s var(--ease),border-color .35s var(--ease)}
.does .step a.go svg{width:22px;height:12px;transition:transform .35s var(--ease)}
.does .step a.go:hover,.does .step a.go:focus-visible{color:var(--cobalt-deep);border-color:var(--cobalt-deep)}
.does .step a.go:hover svg,.does .step a.go:focus-visible svg{transform:translateX(8px)}
.does .plate{position:sticky;top:0;height:100svh;background:var(--cobalt);color:#fff;overflow:hidden}
.does .plate .pi{position:absolute;inset:0;opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease),transform .7s var(--ease);pointer-events:none}
.does .plate .pi.on{opacity:1;transform:none}
.does .plate .word{position:absolute;left:clamp(1.6rem,3vw,3.4rem);bottom:clamp(2.4rem,9vh,6rem);font-weight:900;font-variation-settings:"wdth" 118;font-size:clamp(50px,6.3vw,128px);line-height:.8;letter-spacing:-.05em}
.does .plate .nt{position:absolute;top:clamp(2rem,7vh,4.5rem);right:var(--m);text-align:right;font-size:max(11px,.6rem);letter-spacing:.2em;text-transform:uppercase;line-height:1.9;color:#DCE8FF}
.does .plate .nt::after{content:"";display:block;width:1.8rem;height:1px;background:#DCE8FF;margin:.5rem 0 0 auto}
.does .plate .pull{position:absolute;left:clamp(1.6rem,3vw,3.4rem);top:clamp(2rem,7vh,4.5rem);max-width:19ch;font-family:var(--serif);font-style:italic;font-size:clamp(1.1rem,1.5vw,1.6rem);line-height:1.35}
.does .plate .pull small{display:block;margin-top:1rem;font-family:var(--grot);font-style:normal;font-size:max(11px,.6rem);letter-spacing:.22em;text-transform:uppercase;color:#DCE8FF}
.does .plate svg.tree{position:absolute;left:6%;top:14%;width:88%;height:62%}
.does .plate svg.tree path{fill:none;stroke:#fff;stroke-width:1.6;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.1s var(--ease)}
.does .plate svg.tree path.mx{stroke:#9CC0FF;stroke-dasharray:5 6;stroke-dashoffset:0;opacity:0;transition:opacity .8s var(--ease) .7s}
.does .plate .pi.on svg.tree path{stroke-dashoffset:0}
.does .plate .pi.on svg.tree path.mx{opacity:1}
.does .plate svg.tree text{font:700 13px var(--grot);fill:#fff;letter-spacing:.04em}
.does .plate svg.tree rect{fill:var(--cobalt);stroke:#fff;stroke-width:1.5}
@media (max-width:900px){
  .does{grid-template-columns:1fr}
  .does .steps{padding:0 var(--m)}
  .does .intro{min-height:0;padding:clamp(3.5rem,8vh,5rem) 0 2rem}
  .does .plate{display:none}
  .does .step{min-height:0;opacity:1;padding:2.2rem 0 2.6rem}
  .does .step .kw{display:block;font-family:var(--grot);max-width:none;font-weight:900;font-variation-settings:"wdth" 118;font-size:clamp(52px,15vw,84px);line-height:.85;letter-spacing:-.05em;color:var(--cobalt);margin-bottom:1.2rem}
}

/* ============ SCENE 03 — CARTA DEL AUTOR (propuesta) ============ */
.letter{position:relative;z-index:2;background:var(--paper);border-top:1px solid var(--line);padding:clamp(5rem,12vh,9rem) var(--m) clamp(5rem,12vh,9rem);display:grid;grid-template-columns:minmax(0,28%) minmax(0,1fr);gap:clamp(2rem,5vw,6rem)}
.letter .side{align-self:start;position:sticky;top:clamp(2rem,10vh,6rem)}
.letter .side .eyebrow{color:var(--graphite);margin-bottom:1.4rem}
.letter .side p{font-size:max(11px,.66rem);letter-spacing:.2em;text-transform:uppercase;color:var(--ink2);line-height:1.9}
.letter .body{font-family:var(--serif);font-size:clamp(26px,3.1vw,56px);line-height:1.22;letter-spacing:-.015em;max-width:26ch}
.letter .body .w{opacity:.2;transition:opacity .35s var(--ease)}
.letter .body .w.on{opacity:1}
.letter .body em{font-style:italic;color:var(--cobalt)}
.letter .sign{margin-top:clamp(2rem,5vh,3.4rem);font-family:var(--serif);font-style:italic;font-size:clamp(1.1rem,1.5vw,1.5rem);color:var(--graphite)}
.letter .sign small{display:block;margin-top:.5rem;font-family:var(--grot);font-style:normal;font-size:max(11px,.62rem);letter-spacing:.24em;text-transform:uppercase;color:var(--ink2)}
@media (max-width:900px){.letter{grid-template-columns:1fr}.letter .side{position:static}}
@media (prefers-reduced-motion:reduce){.does .step{opacity:1}.does .plate .pi{transition:none}.letter .body .w{opacity:1}}

@media (prefers-reduced-motion:reduce){
  .hero{height:100svh}.hero .stage{position:relative}
  .hero .maskwrap{animation:none;opacity:1;transform:none}
  .hero .mark,.hero .menu,.hero .role,.hero .quote,.hero .cue{animation:none;opacity:1}
  .reveal{opacity:1;transform:none;transition:none}
  .strip{height:auto}.strip .scene{position:relative;top:0;height:86svh}
  .book .object .layer{transition:none}
}

/* --- film de apertura: pausa la animación de la portada hasta que termina --- */
.hero .film{z-index:6;transition:opacity .9s var(--ease)}
.hero.filming .maskwrap,.hero.filming .mark,.hero.filming .topright,.hero.filming .role,.hero.filming .quote,.hero.filming .cue,.hero.filming .read{animation-play-state:paused}
.hero .film.done{opacity:0;pointer-events:none}
