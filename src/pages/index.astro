<script is:inline>
(function(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !window.gsap) return;
  var hero=document.getElementById('hero'), film=document.getElementById('film'),
      skip=document.getElementById('skip'), snd=document.getElementById('snd'), au=document.getElementById('fa'), want=false, replay=document.getElementById('replay'), tl=null, ended=false;
  hero.classList.add('filming');
  function setSnd(on){ want=on; snd.setAttribute('aria-pressed',on); snd.textContent=on?'Sound: on':'Sound: off';
    snd.setAttribute('aria-label',on?'Mute the film':'Turn the film sound on'); }
  function startAudio(){ if(!want||ended) return; au.volume=1; au.currentTime=tl?tl.time():0; var pr=au.play(); if(pr&&pr.catch) pr.catch(function(){ setSnd(false); }); }
  function fadeOut(){ var v={x:au.volume}; gsap.to(v,{x:0,duration:.8,onUpdate:function(){ au.volume=Math.max(0,v.x); },onComplete:function(){ au.pause(); }}); }
  snd.addEventListener('click',function(){ if(want){ setSnd(false); au.pause(); } else { setSnd(true); startAudio(); } });
  function finish(){
    if (ended) return; ended=true;
    if (tl) tl.pause();
    fadeOut(); snd.hidden=true;
    film.classList.add('done'); skip.hidden=true; replay.hidden=false;
    hero.classList.remove('filming');
    removeEventListener('wheel',bail); removeEventListener('touchmove',bail); removeEventListener('keydown',bail);
  }
  function bail(e){ if(e.type==='keydown' && ['ArrowDown','PageDown','Space',' ','End'].indexOf(e.key)<0 && e.code!=='Space') return; finish(); }
  function play(){
    ended=false; hero.classList.add('filming'); film.classList.remove('done'); skip.hidden=false; snd.hidden=false; replay.hidden=true; au.pause(); au.currentTime=0;
    scrollTo(0,0);
    tl = buildFilm(film); tl.eventCallback('onComplete', function(){ setTimeout(finish,500); }); tl.play(0); startAudio();
    addEventListener('wheel',bail,{passive:true}); addEventListener('touchmove',bail,{passive:true}); addEventListener('keydown',bail);
  }
  skip.addEventListener('click',finish);
  replay.addEventListener('click',function(){ hero.classList.add('filming'); play(); });
  (document.fonts&&document.fonts.ready?document.fonts.ready:Promise.resolve()).then(play);
})();
</script>
<script is:inline>
(function(){
  var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var E = function(id){ return document.getElementById(id); };

  /* enter states only */
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  },{threshold:.25});
  document.querySelectorAll('.reveal, .book-metrics').forEach(function(el){ io.observe(el); });
  if(RM) return;

  var hero=E('hero'), photo=E('photo'), maskwrap=E('maskwrap');
  var heroL1D=E('heroL1D'), heroL2D=E('heroL2D'), heroL1M=E('heroL1M'), heroL2M=E('heroL2M');
  var dsvg=document.querySelector('.name-mask.desktop');
  function fitMask(){ if(dsvg) dsvg.setAttribute('preserveAspectRatio', innerWidth/innerHeight<1.7?'xMidYMid meet':'xMidYMid slice'); }
  fitMask(); addEventListener('resize',fitMask,{passive:true});
  var book=E('book'), obj=E('object'), bp=E('bp'), chair=E('chair');
  var strip=E('strip'), sbg=E('sbg'), sfig=E('sfig'), ssay=E('ssay'), sshadow=E('sshadow');
  var pointer={x:0,y:0}, fine=matchMedia('(pointer:fine)').matches, ticking=false;

  function lerp(a,b,t){ return a+(b-a)*t; }
  function clamp01(v){ return v<0?0:v>1?1:v; }
  /* progress of an element through the viewport: 0 entering, 1 leaving */
  function through(el){
    var r=el.getBoundingClientRect();
    return clamp01((innerHeight-r.top)/(innerHeight+r.height));
  }

  function frame(){
    ticking=false;

    /* ---------- 00 HERO ---------- */
    var p=clamp01(scrollY/(hero.offsetHeight-innerHeight));
    photo.style.transform='translate3d(0,'+lerp(0,-9,p)+'svh,0) scale('+lerp(1.10,1.035,p)+')';
    var drift=clamp01((p-.28)/.52);
    if(heroL1D) heroL1D.setAttribute('transform','translate('+lerp(0,-34,drift)+' 0)');
    if(heroL2D) heroL2D.setAttribute('transform','translate('+lerp(0,34,drift)+' 0)');
    if(heroL1M) heroL1M.setAttribute('transform','translate('+lerp(0,-10,drift)+' 0)');
    if(heroL2M) heroL2M.setAttribute('transform','translate('+lerp(0,10,drift)+' 0)');
    if(maskwrap) maskwrap.style.transform='translate3d(0,'+lerp(0,-10,clamp01((p-.78)/.22))+'svh,0)';

    /* ---------- 01 BOOK OBJECT ---------- */
    var q=(through(book)-.5)*2;                       /* -1 .. 1 */
    if(bp) bp.style.transform='translate3d(calc(-50% + '+(pointer.x*-18)+'px), calc(-50% + '+lerp(-24,32,(q+1)/2)+'px + '+(pointer.y*-14)+'px), 0)';
    if(chair) chair.style.transform='translate3d(calc(-50% + '+(pointer.x*10)+'px), calc(-50% + '+lerp(34,-22,(q+1)/2)+'px + '+(pointer.y*8)+'px), 0)';

    /* ---------- 02 CINEMATIC ---------- */
    var t=through(strip);
    sbg.style.transform='translate3d(0,'+lerp(25,-25,t)+'px,0) scale('+lerp(1.035,1,t)+')';
    sfig.style.transform='translate3d('+lerp(-12,10,t)+'px,'+lerp(70,-55,t)+'px,0)';
    ssay.style.transform='translate3d(0,calc(-50% + '+lerp(25,-18,t)+'px),0)';
    sshadow.style.transform='translate(-50%,0) scaleX('+lerp(.85,1.18,t)+')';
    sshadow.style.opacity=lerp(.32,.16,t);
  }

  addEventListener('scroll',function(){ if(!ticking){ requestAnimationFrame(frame); ticking=true; } },{passive:true});
  addEventListener('resize',function(){ if(!ticking){ requestAnimationFrame(frame); ticking=true; } },{passive:true});

  if(fine){
    obj.addEventListener('pointermove',function(e){
      var b=obj.getBoundingClientRect();
      pointer.x=(e.clientX-b.left)/b.width-.5;
      pointer.y=(e.clientY-b.top)/b.height-.5;
      if(!ticking){ requestAnimationFrame(frame); ticking=true; }
    });
    obj.addEventListener('pointerleave',function(){ pointer.x=0; pointer.y=0; frame(); });
  }
  frame();
})();
</script>

<script is:inline>
(function(){
  var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* plate: la lamina azul cambia segun el paso que esta en el centro de la pantalla */
  var steps=[].slice.call(document.querySelectorAll('.does .step')), plates=[].slice.call(document.querySelectorAll('.does .pi'));
  function setOn(i){steps.forEach(function(s,k){s.classList.toggle('on',k===i)});plates.forEach(function(p,k){p.classList.toggle('on',k===i)})}
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)setOn(+e.target.dataset.i)})},{rootMargin:'-45% 0px -45% 0px',threshold:0});
    steps.forEach(function(s){io.observe(s)});
  }
  /* carta: cada palabra se enciende al leerla */
  var body=document.getElementById('letterBody'); if(!body)return;
  var words=[];
  (function split(node){
    [].slice.call(node.childNodes).forEach(function(n){
      if(n.nodeType===3){var f=document.createDocumentFragment();n.textContent.split(/(\s+)/).forEach(function(t){if(!t)return;if(/^\s+$/.test(t)){f.appendChild(document.createTextNode(t))}else{var s=document.createElement('span');s.className='w';s.textContent=t;f.appendChild(s);words.push(s)}});node.replaceChild(f,n)}
      else if(n.nodeType===1)split(n);
    });
  })(body);
  function paint(){
    if(RM){words.forEach(function(w){w.classList.add('on')});return}
    var r=body.getBoundingClientRect(), h=innerHeight;
    var p=Math.min(1,Math.max(0,(h*.85-r.top)/(r.height+h*.25)));
    var n=Math.round(p*words.length);
    words.forEach(function(w,i){w.classList.toggle('on',i<n)});
  }
  addEventListener('scroll',paint,{passive:true});addEventListener('resize',paint,{passive:true});paint();
})();
</script>
