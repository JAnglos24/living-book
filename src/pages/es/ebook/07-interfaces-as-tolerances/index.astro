/><rect x="69.0" y="158" width="30" height="28" rx="6" fill="none" stroke="#1d3fd8" stroke-width="1" stroke-dasharray="3 2" opacity=".6"/><rect x="138.0" y="162" width="20" height="20" rx="3" fill="#1d3fd8"/><rect x="133.0" y="158" width="30" height="28" rx="6" fill="none" stroke="#1d3fd8" stroke-width="1" stroke-dasharray="3 2" opacity=".6"/><rect x="202.0" y="162" width="20" height="20" rx="3" fill="#1d3fd8"/><rect x="197.0" y="158" width="30" height="28" rx="6" fill="none" stroke="#1d3fd8" stroke-width="1" stroke-dasharray="3 2" opacity=".6"/><rect x="266.0" y="162" width="20" height="20" rx="3" fill="#1d3fd8"/><rect x="261.0" y="158" width="30" height="28" rx="6" fill="none" stroke="#1d3fd8" stroke-width="1" stroke-dasharray="3 2" opacity=".6"/><path d="M10 230 H350" stroke="#1a1a1a" stroke-width="1.5" stroke-dasharray="6 4"/><text x="180" y="224" font-size="9" fill="#1a1a1a" text-anchor="middle" font-family="Helvetica,Arial,sans-serif">Circulación y acceso</text></g><text x="490" y="55" font-size="13" font-weight="700" fill="#1a1a1a" font-family="Helvetica,Arial,sans-serif">Configuración B — menos butacas, más espacio</text><text x="490" y="335" font-size="11" fill="#555" font-family="Helvetica,Arial,sans-serif">Menor capacidad · más margen de acceso y mantenimiento</text><rect x="30" y="365" width="14" height="14" rx="3" fill="#1d3fd8"/><text x="50" y="376" font-size="11" fill="#1a1a1a" font-family="Helvetica,Arial,sans-serif">Butaca</text><rect x="130" y="362" width="22" height="20" rx="6" fill="none" stroke="#1d3fd8" stroke-width="1" stroke-dasharray="3 2"/><text x="160" y="376" font-size="11" fill="#1a1a1a" font-family="Helvetica,Arial,sans-serif">Envolvente de movimiento</text><text x="850" y="376" font-size="10" fill="#777" text-anchor="end" font-family="Helvetica,Arial,sans-serif">Esquema ilustrativo, sin dimensiones calculadas</text></svg>
