<footer>
  <span>J. Angel Sosa — Mexico, 2026</span>
  <nav aria-label="Links"><a href="https://www.linkedin.com/" rel="me">LinkedIn</a><a href="https://github.com/" rel="me">GitHub</a><a href="/privacy/">Privacy</a></nav>
</footer>

<script>
(function(){
  var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var E = function(id){ return document.getElementById(id); };

  /* enter states only */
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  },{threshold:.25});
  document.querySelectorAll('.reveal, .book-metrics').forEach(function(el){ io.observe(el); });
  if(RM) return;

  var hero=E('hero'), photo=E('photo'), maskwrap=E('maskwrap');
  var heroL1D=E('heroL1D'), heroL2D=E('heroL2D'), heroL1M=E('heroL1M'), heroL2M=E('heroL2M');
  var book=E('book'), obj=E('object'), bp=E('bp'), chair=E('chair');
  var strip=E('strip'), sbg=E('sbg'), sfig=E('sfig'), ssay=E('ssay'), sshadow=E('sshadow');
  var pointer={x:0,y:0}, fine=matchMedia('(pointer:fine)').matches, ticking=false;

  function lerp(a,b,t){ return a+(b-a)*t; }
  function clamp01(v){ return v<0?0:v>1?1:v; }
  /* progress of an element through the viewport: 0 entering, 1 leaving */
  function through(el){
    var r=el.getBoundingClientRect();
    return clamp01((innerHeight-r.top)/(innerHeight+r.height));
  }

  function frame(){
    ticking=false;

    /* ---------- 00 HERO ---------- */
    var p=clamp01(scrollY/(hero.offsetHeight-innerHeight));
    photo.style.transform='translate3d(0,'+lerp(0,-9,p)+'svh,0) scale('+lerp(1.10,1.035,p)+')';
    var drift=clamp01((p-.28)/.52);
    if(heroL1D) heroL1D.setAttribute('transform','translate('+lerp(0,-34,drift)+' 0)');
    if(heroL2D) heroL2D.setAttribute('transform','translate('+lerp(0,34,drift)+' 0)');
    if(heroL1M) heroL1M.setAttribute('transform','translate('+lerp(0,-10,drift)+' 0)');
    if(heroL2M) heroL2M.setAttribute('transform','translate('+lerp(0,10,drift)+' 0)');
    if(maskwrap) maskwrap.style.transform='translate3d(0,'+lerp(0,-10,clamp01((p-.78)/.22))+'svh,0)';

    /* ---------- 01 BOOK OBJECT ---------- */
    var q=(through(book)-.5)*2;                       /* -1 .. 1 */
    if(bp) bp.style.transform='translate3d(calc(-50% + '+(pointer.x*-18)+'px), calc(-50% + '+lerp(-24,32,(q+1)/2)+'px + '+(pointer.y*-14)+'px), 0)';
    if(chair) chair.style.transform='translate3d(calc(-50% + '+(pointer.x*10)+'px), calc(-50% + '+lerp(34,-22,(q+1)/2)+'px + '+(pointer.y*8)+'px), 0)';

    /* ---------- 02 CINEMATIC ---------- */
    var t=through(strip);
    sbg.style.transform='translate3d(0,'+lerp(25,-25,t)+'px,0) scale('+lerp(1.035,1,t)+')';
    sfig.style.transform='translate3d('+lerp(-12,10,t)+'px,'+lerp(70,-55,t)+'px,0)';
    ssay.style.transform='translate3d(0,calc(-50% + '+lerp(25,-18,t)+'px),0)';
    sshadow.style.transform='translate(-50%,0) scaleX('+lerp(.85,1.18,t)+')';
    sshadow.style.opacity=lerp(.32,.16,t);
  }

  addEventListener('scroll',function(){ if(!ticking){ requestAnimationFrame(frame); ticking=true; } },{passive:true});
  addEventListener('resize',function(){ if(!ticking){ requestAnimationFrame(frame); ticking=true; } },{passive:true});

  if(fine){
    obj.addEventListener('pointermove',function(e){
      var b=obj.getBoundingClientRect();
      pointer.x=(e.clientX-b.left)/b.width-.5;
      pointer.y=(e.clientY-b.top)/b.height-.5;
      if(!ticking){ requestAnimationFrame(frame); ticking=true; }
    });
    obj.addEventListener('pointerleave',function(){ pointer.x=0; pointer.y=0; frame(); });
  }
  frame();
})();
</script>
</body>
</html>
