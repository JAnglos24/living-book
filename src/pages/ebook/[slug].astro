---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import legacyCss from '../../styles/chapter-legacy.css?raw';
import editorialCss from '../../styles/chapter-editorial.css?raw';

export async function getStaticPaths() {
  const chapterEntries = await getCollection('ebook');
  return chapterEntries.map(entry => ({
    params: { slug: entry.id || `chapter-${entry.data.chapter.toString().padStart(2, '0')}` },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const chapterSlug = entry.id || `chapter-${entry.data.chapter.toString().padStart(2, '0')}`;
const chapterImage = entry.data.og_image || entry.data.hero_image || `/assets/chapter-${entry.data.chapter.toString().padStart(2, '0')}-thumb.jpg`;
const editorial = entry.data.chapter >= 5;
---
<Layout 
  title={`${entry.data.title} — Thinking in Products, Building Systems`}
  description={entry.data.summary || `Chapter ${entry.data.chapter} of The Living Book by J. Angel Sosa.`}
  ogImage={chapterImage}
  ogType="article"
  ogUrl={`https://www.jasosal.com/ebook/${chapterSlug}/`}
>
  {/* Ch 1-4 keep their original stylesheet; ch >= 5 use the approved editorial system (Living book/Chapter5/ebook-chapter-05.html). */}
  <Fragment set:html={`<style>${editorial ? editorialCss : legacyCss}</style>`} />

  <Content />

  <script is:inline>
  (function(){
    var btn=document.getElementById('tocBtn'), panel=document.getElementById('tocPanel'),
        overlay=document.getElementById('tocOverlay'), close=document.getElementById('tocClose');
    function open(){ panel.classList.add('open'); overlay.classList.add('open'); close.focus(); document.addEventListener('keydown', onKey); }
    function shut(){ panel.classList.remove('open'); overlay.classList.remove('open'); btn.focus(); document.removeEventListener('keydown', onKey); }
    function onKey(e){
      if(e.key==='Escape'){ shut(); lightboxShut(); }
      if(e.key==='ArrowRight'){ /* no next chapter yet */ }
      if(e.key==='ArrowLeft'){ /* no previous chapter */ }
    }
    if(btn) btn.addEventListener('click', function(){ if(panel){ open(); } else { window.location.href='/ebook/#toc'; } });
    if(close) close.addEventListener('click', shut);
    if(overlay) overlay.addEventListener('click', shut);
    panel?.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', shut); });

    var lb=document.getElementById('lightbox'), lbClose=document.getElementById('lightboxClose');
    function lightboxShut(){ lb?.classList.remove('open'); }
    if(lbClose) lbClose.addEventListener('click', lightboxShut);
    document.querySelectorAll('.catalog figure, .ribbon figure').forEach(function(f){
      f.style.cursor='zoom-in';
      f.addEventListener('click', function(){ lb?.classList.add('open'); lbClose?.focus(); });
    });

    var bar=document.getElementById('progressBar');
    function onScroll(){
      var h=document.documentElement, p=(h.scrollTop)/(h.scrollHeight-h.clientHeight)*100;
      if(bar) bar.style.setProperty('--p', p+'%');
    }
    document.addEventListener('scroll', onScroll, {passive:true}); onScroll();
  })();
  </script>

</Layout>
