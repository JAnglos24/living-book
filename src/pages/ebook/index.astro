<title>Thinking in Products, Building Systems — The Living Book</title>
<meta name="description" content="A living digital book on physical design, digital products, projects and enterprise portfolios, published one chapter a week.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,500;1,8..60,400&display=swap" rel="stylesheet">
<style>
:root{
  --cobalt:#0057D9; --cobalt-deep:#003F9E; --cobalt-light:#2E7CFF;
  --paper:#F7F8FA; --white:#FFFFFF; --graphite:#111418; --ink2:#5C6673; --line:#C9D0D8; --grid-blue:rgba(0,87,217,.12);
  --grot:"Archivo",system-ui,sans-serif; --serif:"Source Serif 4",Georgia,serif;
  --margin:clamp(24px,4vw,72px); --gutter:clamp(20px,2.4vw,42px); --max:1600px;
  --ease:cubic-bezier(.65,0,.35,1);
}
*{box-sizing:border-box} html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--graphite);font-family:var(--grot);font-size:clamp(16px,.35vw + 14px,20px);line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0} a{color:inherit} img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--cobalt);outline-offset:3px}
.wrap{max-width:var(--max);margin-inline:auto;padding-inline:var(--margin)}
.eyebrow{font-size:13px;letter-spacing:.14em;font-weight:600}

/* ===== top bar ===== */
.topbar{position:sticky;top:0;z-index:20;background:var(--white);border-bottom:1px solid var(--line)}
.topbar .row{display:flex;align-items:center;justify-content:space-between;padding-block:16px}
.topbar a.home{font-weight:700;text-decoration:none;font-size:15px;letter-spacing:.02em}
.topbar nav{display:flex;align-items:center;gap:28px;font-size:14px}
.topbar nav a{text-decoration:none;color:var(--ink2)}
.topbar .lang{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink2)}
.topbar .lang a{text-decoration:none;color:var(--ink2)}
.topbar .lang a[aria-current]{color:var(--graphite);font-weight:700}
.topbar button.toc-btn{font:inherit;font-size:14px;font-weight:600;color:var(--cobalt);background:none;border:1.5px solid var(--cobalt);border-radius:999px;padding:8px 18px;cursor:pointer;transition:background .2s var(--ease),color .2s var(--ease)}
.topbar button.toc-btn:hover{background:var(--cobalt);color:#fff}
.progress{height:2px;background:var(--grid-blue)}
.progress i{display:block;height:100%;width:var(--p,0%);background:var(--cobalt);transition:width .1s linear}

/* ===== cover ===== */
.cover{position:relative;background:var(--cobalt);color:#fff;overflow:hidden;min-height:78svh;display:flex;align-items:flex-end}
.cover .num{position:absolute;right:calc(var(--margin) * -0.4);top:50%;transform:translateY(-50%);font-family:var(--grot);font-weight:900;font-variation-settings:"wdth" 112;font-size:clamp(220px,34vw,560px);line-height:1;color:#fff;opacity:.12;letter-spacing:-.04em;pointer-events:none;user-select:none}
.cover .wrap{position:relative;z-index:1;padding-block:56px clamp(48px,8vh,88px)}
.cover .eyebrow{color:#fff;display:flex;align-items:center;gap:14px}
.cover .eyebrow::after{content:"";flex:0 0 40px;height:1px;background:rgba(255,255,255,.55)}
.cover h1{font-weight:800;font-variation-settings:"wdth" 100;font-size:clamp(64px,10vw,170px);line-height:.94;letter-spacing:-.04em;margin:24px 0 20px;max-width:13ch}
.cover .sub{font-size:clamp(17px,1.6vw,22px);line-height:1.4;max-width:44ch;color:rgba(255,255,255,.86);margin-bottom:36px}
.cover .meta{font-size:14px;color:rgba(255,255,255,.75);margin-bottom:28px}
.cover .cta-row{display:flex;flex-wrap:wrap;gap:14px}
.btn{font:inherit;font-size:15px;font-weight:600;text-decoration:none;padding:14px 24px;border-radius:999px;border:1.5px solid transparent;display:inline-flex;align-items:center;gap:10px;transition:background .2s var(--ease),color .2s var(--ease),border-color .2s var(--ease)}
.btn.solid{background:#fff;color:var(--cobalt-deep)}
.btn.solid:hover{background:var(--paper)}
.btn.outline{border-color:rgba(255,255,255,.6);color:#fff}
.btn.outline:hover{border-color:#fff;background:rgba(255,255,255,.1)}

/* ===== about (white info field) ===== */
.about{background:var(--white)}
.about .wrap{padding-block:clamp(56px,9vh,96px);display:grid;grid-template-columns:5fr 7fr;gap:var(--gutter)}
.about h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(36px,4.8vw,78px);line-height:1.02;letter-spacing:-.03em;max-width:11ch}
.about .copy{max-width:66ch;font-size:1em;line-height:1.6;color:#242A31}
.about .copy p{margin-bottom:1.1em}
@media (max-width:860px){.about .wrap{grid-template-columns:1fr;gap:20px}}

/* ===== facts ===== */
.facts{background:var(--white);border-top:1px solid var(--line)}
.facts .wrap{padding-block:clamp(40px,7vh,64px);display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gutter)}
.facts div{border-left:1px solid var(--line);padding-left:20px}
.facts b{display:block;font-family:var(--serif);font-weight:500;font-size:clamp(64px,7vw,118px);line-height:.92;letter-spacing:-.01em;margin-bottom:10px}
.facts span{font-size:13px;letter-spacing:.04em;color:var(--ink2);line-height:1.5}
@media (max-width:700px){.facts .wrap{grid-template-columns:1fr}}

/* ===== continue reading ===== */
.continue{background:var(--paper);border-top:1px solid var(--line)}
.continue .wrap{padding-block:clamp(48px,8vh,80px)}
.continue .head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:28px;flex-wrap:wrap}
.continue h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(28px,3.2vw,42px);letter-spacing:-.02em}
.continue .head a{font-size:14px;font-weight:600;color:var(--cobalt);text-decoration:none}
.chapcard{display:grid;grid-template-columns:1fr 1.4fr;gap:var(--gutter);background:var(--white);border:1px solid var(--line);align-items:stretch}
.chapcard .img{aspect-ratio:16/9;background:linear-gradient(135deg,var(--grid-blue),var(--white));display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-style:italic;color:var(--cobalt);font-size:14px}
.chapcard .body{padding:clamp(20px,3vw,40px) clamp(20px,3vw,40px) clamp(20px,3vw,40px) 0}
.chapcard .kicker{font-size:13px;color:var(--ink2);margin-bottom:10px}
.chapcard h3{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(24px,2.6vw,36px);line-height:1.08;letter-spacing:-.02em;margin-bottom:12px;max-width:20ch}
.chapcard h3 a{text-decoration:none}
.chapcard p{color:var(--ink2);max-width:50ch;margin-bottom:16px}
.chapcard .link{font-size:14px;font-weight:600;color:var(--cobalt);text-decoration:none}
@media (max-width:760px){.chapcard{grid-template-columns:1fr}.chapcard .body{padding:20px}}

/* ===== table of contents by part ===== */
.toc-section{background:var(--white);border-top:1px solid var(--line)}
.toc-section .wrap{padding-block:clamp(48px,8vh,80px)}
.toc-section h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(28px,3.2vw,42px);letter-spacing:-.02em;margin-bottom:32px}
.part{border-top:1px solid var(--line);padding-block:26px}
.part:last-child{border-bottom:1px solid var(--line)}
.part .partmeta{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:16px}
.part .partmeta b{font-family:var(--serif);font-weight:500;font-size:20px}
.part .partmeta span{font-size:13px;color:var(--ink2)}
.chlist{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.chlist li{display:grid;grid-template-columns:2.6rem 1fr auto;gap:14px;align-items:baseline;padding:10px 8px;border-radius:6px}
.chlist li.published{cursor:default}
.chlist li a{text-decoration:none;display:contents}
.chlist .n{font-family:var(--serif);color:var(--ink2);font-size:15px}
.chlist .t{font-size:15px}
.chlist .t.locked{color:var(--ink2)}
.chlist .st{font-size:12px;color:var(--ink2);white-space:nowrap}
.chlist li:has(a):hover{background:var(--paper)}

/* ===== edition / changelog ===== */
.edition{background:var(--paper);border-top:1px solid var(--line)}
.edition .wrap{padding-block:clamp(40px,7vh,64px);display:grid;grid-template-columns:1fr 1fr;gap:var(--gutter)}
.edition h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(22px,2.4vw,30px);letter-spacing:-.02em;margin-bottom:18px}
.edition ul{list-style:none;margin:0;padding:0;font-size:14px;color:var(--ink2)}
.edition li{display:flex;gap:14px;padding:10px 0;border-top:1px solid var(--line)}
.edition li b{color:var(--graphite);font-weight:600;min-width:5.5rem}
.pdfcard{border:1px solid var(--line);background:var(--white);padding:28px;align-self:start}
.pdfcard b{display:block;font-size:15px;margin-bottom:6px}
.pdfcard span{display:block;font-size:13px;color:var(--ink2);margin-bottom:18px}
@media (max-width:760px){.edition .wrap{grid-template-columns:1fr}}

footer{background:var(--white);border-top:1px solid var(--line)}
footer .wrap{padding-block:24px 40px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink2)}
footer a{text-decoration:none}

/* ===== TOC slide-over ===== */
.toc-overlay{position:fixed;inset:0;background:rgba(17,20,24,.4);opacity:0;pointer-events:none;transition:opacity .3s var(--ease);z-index:30}
.toc-overlay.open{opacity:1;pointer-events:auto}
.toc-panel{position:fixed;top:0;right:0;height:100%;width:min(420px,88vw);background:var(--white);transform:translateX(100%);transition:transform .35s var(--ease);z-index:31;overflow-y:auto;padding:24px}
.toc-panel.open{transform:translateX(0)}
.toc-panel .close{font:inherit;font-size:14px;background:none;border:none;cursor:pointer;color:var(--ink2);padding:8px}
@media (prefers-reduced-motion:reduce){.toc-overlay,.toc-panel{transition:none}}
</style>
