<style>
:root{
  --cobalt:#0057D9; --cobalt-deep:#003F9E; --cobalt-light:#2E7CFF;
  --paper:#F7F8FA; --white:#FFFFFF; --graphite:#111418; --ink2:#5C6673; --line:#C9D0D8; --grid-blue:rgba(0,87,217,.12);
  --grot:"Archivo",system-ui,sans-serif; --serif:"Source Serif 4",Georgia,serif;
  --margin:clamp(24px,4vw,72px); --gutter:clamp(20px,2.4vw,42px); --max:1600px;
  --ease:cubic-bezier(.65,0,.35,1);
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--graphite);font-family:var(--grot);font-size:clamp(16px,.35vw + 14px,20px);line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0} a{color:inherit} img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--cobalt);outline-offset:3px}
.wrap{max-width:var(--max);margin-inline:auto;padding-inline:var(--margin)}

/* ===== topbar ===== */
.topbar{position:sticky;top:0;z-index:20;background:var(--white);border-bottom:1px solid var(--line)}
.topbar .row{display:flex;align-items:center;justify-content:space-between;padding-block:16px;gap:16px}
.topbar a.home{font-weight:700;text-decoration:none;font-size:15px}
.topbar nav{display:flex;align-items:center;gap:28px;font-size:14px}
.topbar nav a{text-decoration:none;color:var(--ink2)}
.topbar nav a[aria-current]{color:var(--graphite);font-weight:700}
.topbar .lang{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink2)}
.topbar .lang a{text-decoration:none;color:var(--ink2)}
.topbar .lang a[aria-current]{color:var(--graphite);font-weight:700}

/* ===== hero ===== */
.hero{background:var(--cobalt);color:#fff;position:relative;overflow:hidden}
.hero .wrap{padding-block:clamp(56px,10vh,96px)}
.hero .eyebrow{font-size:13px;letter-spacing:.14em;font-weight:600;color:rgba(255,255,255,.85);display:flex;align-items:center;gap:14px;margin-bottom:20px}
.hero .eyebrow::after{content:"";flex:0 0 40px;height:1px;background:rgba(255,255,255,.5)}
.hero h1{font-weight:800;font-variation-settings:"wdth" 100;font-size:clamp(44px,6.5vw,96px);line-height:1;letter-spacing:-.035em;margin-bottom:20px;max-width:15ch}
.hero p{font-size:clamp(17px,1.5vw,22px);max-width:54ch;color:rgba(255,255,255,.88);line-height:1.45}

/* ===== grid list ===== */
.ideas-grid{padding-block:clamp(48px,8vh,80px);display:grid;grid-template-columns:repeat(2,1fr);gap:var(--gutter)}
@media (max-width:860px){.ideas-grid{grid-template-columns:1fr}}

.idea-card{background:var(--white);border:1px solid var(--line);border-radius:2px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.idea-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(17,20,24,.08)}
.idea-card .img-box{position:relative;background:var(--paper);overflow:hidden;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center}
.idea-card .img-box img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.idea-card:hover .img-box img{transform:scale(1.04)}
.idea-card .tag-badge{position:absolute;top:16px;left:16px;background:rgba(17,20,24,.85);backdrop-filter:blur(8px);color:#fff;font-size:11px;letter-spacing:.12em;font-weight:600;padding:5px 12px;border-radius:999px;text-transform:uppercase}

.idea-card .body{padding:28px 32px 36px;display:flex;flex-direction:column;flex:1}
.idea-card h2{font-weight:700;font-variation-settings:"wdth" 96;font-size:clamp(22px,2vw,30px);line-height:1.15;letter-spacing:-.02em;margin-bottom:12px;color:var(--graphite)}
.idea-card .desc{color:var(--ink2);font-size:15px;line-height:1.6;margin-bottom:24px;flex:1}
.idea-card .specs{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;border-top:1px solid var(--line);padding-top:20px;font-size:13px;color:var(--ink2)}
.idea-card .specs strong{display:block;color:var(--graphite);font-weight:600;font-size:12px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}

/* ===== MODU-PHON Hero Spotlight ===== */
.modu-spotlight{background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:clamp(48px,8vh,80px)}
.modu-spotlight .wrap{padding-block:clamp(56px,8vh,88px);display:grid;grid-template-columns:1fr 1fr;gap:var(--gutter);align-items:center}
.modu-spotlight .badge{font-size:12px;letter-spacing:.14em;font-weight:700;color:var(--cobalt);text-transform:uppercase;margin-bottom:14px;display:block}
.modu-spotlight h2{font-weight:800;font-variation-settings:"wdth" 100;font-size:clamp(36px,4vw,64px);line-height:1.02;letter-spacing:-.03em;margin-bottom:20px}
.modu-spotlight p{color:var(--ink2);font-size:16px;line-height:1.6;margin-bottom:24px}
.modu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;border-top:1px solid var(--line);padding-top:24px}
.modu-item{font-size:13px}
.modu-item b{display:block;color:var(--graphite);font-weight:700;font-size:14px;margin-bottom:4px}
.modu-item span{color:var(--ink2)}
.modu-visual{background:var(--graphite);color:#fff;border-radius:4px;padding:36px;display:flex;flex-direction:column;justify-content:center;aspect-ratio:4/3;position:relative;overflow:hidden}
.modu-visual::before{content:"9 CARCASAS / 1 NÚCLEO";position:absolute;right:-20px;bottom:-10px;font-size:80px;font-weight:900;color:rgba(255,255,255,.04);letter-spacing:-.05em;pointer-events:none;white-space:nowrap}
.modu-visual .big-num{font-size:clamp(60px,8vw,110px);font-weight:900;line-height:.85;color:var(--cobalt-light);margin-bottom:16px}
.modu-visual .tag{font-size:13px;letter-spacing:.14em;font-weight:600;color:rgba(255,255,255,.8);text-transform:uppercase}

footer{background:var(--white);border-top:1px solid var(--line)}
footer .wrap{padding-block:24px 40px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink2)}
footer a{text-decoration:none}
</style>
</head>
