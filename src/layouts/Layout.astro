`} />
<link rel="preload" href="/fonts/Archivo-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
{isHome ? (
  <style is:inline>
    /* Home specific overrides */
    html,body{background:#F7F8FA;font-size:clamp(15px,.9rem+.25vw,18px);line-height:1.5}
    @media (max-width:800px){:root{--m:22px}}
  </style>
