---
const { title, description, isHome = false, ogImage, ogType, ogUrl, keywords, alternateEn, alternateEs } = Astro.props;
import '../styles/global.css';

const image = ogImage || "https://www.jasosal.com/assets/jas-warm.jpg";
const fullImageUrl = image.startsWith('http') ? image : `https://www.jasosal.com${image}`;
const isEs = Astro.url.pathname.startsWith('/es');
const canonical = new URL(Astro.url.pathname, 'https://www.jasosal.com').href;

let enUrl = alternateEn;
let esUrl = alternateEs;
if (!enUrl && !esUrl) {
  if (isEs) {
    esUrl = canonical;
    enUrl = new URL(Astro.url.pathname.replace(/^\/es(\/|$)/, '/'), 'https://www.jasosal.com').href;
  } else {
    enUrl = canonical;
    esUrl = new URL('/es' + Astro.url.pathname, 'https://www.jasosal.com').href;
  }
}
---
<!doctype html>
<html lang={isEs ? 'es' : 'en'}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title || "José Ángel Sosa — Portfolio Manager | Product Manager Leadership | Product Management"}</title>
<meta name="description" content={description || "José Ángel Sosa López — Senior Portfolio Manager, Product Manager Leadership, Product Management & PMO Director. Experto en arquitectura y gestión de productos tecnológicos, Retail POS y gobernanza."}>
<meta name="keywords" content={keywords || "Portfolio Manager, Product Manager Leadership, Product Management, Gestión de Producto, Líder de Gestión de Producto, Product Manager Lead, PMO Director, Agile Coach, Retail POS, IT Portfolio Governance, José Ángel Sosa López, J. Angel Sosa"}>
<meta name="author" content="José Ángel Sosa López">
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="en" href={enUrl}>
<link rel="alternate" hreflang="es" href={esUrl}>
<link rel="alternate" hreflang="x-default" href={enUrl}>
<link rel="sitemap" href="/sitemap-index.xml">
<meta property="og:locale" content={isEs ? 'es_MX' : 'en_US'}>
<meta property="og:title" content={title || "José Ángel Sosa — Portfolio Manager | Product Manager Leadership | Product Management"}>
<meta property="og:description" content={description || "Liderazgo en Gestión de Producto, Portfolio Management, PMO y Agile Coaching."}>
<meta property="og:type" content={ogType || "profile"}>
<meta property="og:url" content={ogUrl || canonical}>
<meta property="og:image" content={fullImageUrl}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title || "José Ángel Sosa — Portfolio Manager"}>
<meta name="twitter:description" content={description || "Liderazgo en Gestión de Producto, Portfolio Management, PMO y Agile Coaching."}>
<meta name="twitter:image" content={fullImageUrl}>
<script type="application/ld+json" set:html={`
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.jasosal.com/#person",
      "name": "José Ángel Sosa López",
      "alternateName": ["J. Angel Sosa", "José Ángel Sosa"],
      "jobTitle": ["Líder en Gestión de Producto", "Portfolio Manager", "Product Manager Lead", "PMO Director", "Agile Coach"],
      "description": "Líder en Gestión de Producto, Senior Portfolio Manager, PMO Director y Agile Coach. Especialista en estrategia de productos tecnológicos, Retail POS, gobernanza de proyectos y administración de empresas.",
      "birthPlace": {
        "@type": "Place",
        "name": "CDMX, México"
      },
      "url": "https://www.jasosal.com/",
      "image": "https://www.jasosal.com/assets/jas-warm.jpg",
      "sameAs": [
        "https://www.linkedin.com/in/jasosal/",
        "https://github.com/jasosal"
      ],
      "knowsAbout": [
        "Gestión de Producto",
