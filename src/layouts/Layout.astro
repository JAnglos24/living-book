---
const { title, description, isHome = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,500;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
{isHome ? (
  <style is:inline>
    /* Home specific overrides */
    html,body{background:#F7F8FA;font-size:clamp(15px,.9rem+.25vw,18px);line-height:1.5}
    @media (max-width:800px){:root{--m:22px}}
  </style>
) : null}
</head>
<body>
  <slot />
</body>
</html>
