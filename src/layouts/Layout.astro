---
const { title, description, isHome = false } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="keywords" content="Portfolio Manager, Escritor CDMX, Diseño de productos, Administrador de empresas, Misterio en la Biblioteca, Living Book, Retail punto de venta, José Ángel Sosa López">
<meta name="author" content="José Ángel Sosa López">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="profile">
<meta property="og:url" content="https://www.jasosal.com/">
<meta property="og:image" content="https://www.jasosal.com/assets/jas-warm.jpg">
<script type="application/ld+json" set:html={`
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.jasosal.com/#person",
      "name": "José Ángel Sosa López",
      "alternateName": "J. Angel Sosa",
      "jobTitle": "Portfolio Manager",
      "description": "Administrador de empresas con larga carrera en administración de proyectos, productos tecnológicos y retail punto de venta.",
      "birthPlace": {
        "@type": "Place",
        "name": "CDMX, México"
      },
      "url": "https://www.jasosal.com/",
      "image": "https://www.jasosal.com/assets/jas-warm.jpg",
      "sameAs": [
        "https://www.linkedin.com/in/jasosal/",
        "https://github.com/jasosal"
      ],
      "knowsAbout": ["Project Management", "Product Generation", "Retail", "Point of Sale", "Design"]
    },
    {
      "@type": "Book",
      "@id": "https://www.jasosal.com/#book-misterio",
      "name": "Misterio en la Biblioteca",
      "author": {
        "@id": "https://www.jasosal.com/#person"
      },
      "inLanguage": "es"
    },
    {
      "@type": "CreativeWork",
      "@id": "https://www.jasosal.com/#living-book",
      "name": "The Living Book: Thinking in Products, Building Systems",
      "author": {
        "@id": "https://www.jasosal.com/#person"
      },
      "url": "https://www.jasosal.com/ebook/"
    }
  ]
}
`} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,500;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
{isHome ? (
  <style is:inline>
    /* Home specific overrides */
    html,body{background:#F7F8FA;font-size:clamp(15px,.9rem+.25vw,18px);line-height:1.5}
    @media (max-width:800px){:root{--m:22px}}
  </style>
) : null}
</head>
<body>
  <slot />
</body>
</html>
